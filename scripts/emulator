#!/usr/bin/env bash

set -euo pipefail

readonly PROCESS_NAME="servicebus-emulator"
readonly HEALTH_URL="http://127.0.0.1:5300/health"
readonly MAX_ATTEMPTS=90
EMULATOR_OWNERSHIP="none"

process_state() {
  process-compose process get "$PROCESS_NAME" --output json 2>/dev/null
}

is_running() {
  jq -e '.[0].is_running == true' >/dev/null
}

wait_until_ready() {
  local attempt
  for ((attempt = 1; attempt <= MAX_ATTEMPTS; attempt++)); do
    if curl --fail --silent --show-error --max-time 2 "$HEALTH_URL" >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done

  echo "Service Bus emulator did not become ready at $HEALTH_URL" >&2
  process-compose process logs "$PROCESS_NAME" --tail 100 >&2 || true
  return 1
}

start() {
  local state
  if state="$(process_state)"; then
    if is_running <<<"$state"; then
      wait_until_ready
      return
    fi
    process-compose process start "$PROCESS_NAME"
  else
    devenv up -d
  fi

  wait_until_ready
}

stop() {
  if process_state >/dev/null; then
    devenv down
  else
    docker compose down --volumes --remove-orphans
  fi
}

run() {
  local state

  if [[ -n ${SERVICEBUS_CONNECTION_STRING:-} ]]; then
    "$@"
    return
  fi

  if state="$(process_state)"; then
    if ! is_running <<<"$state"; then
      process-compose process start "$PROCESS_NAME"
      EMULATOR_OWNERSHIP="process"
    fi
  else
    devenv up -d
    EMULATOR_OWNERSHIP="project"
  fi

  cleanup() {
    case "$EMULATOR_OWNERSHIP" in
    project)
      devenv down
      ;;
    process)
      process-compose process stop "$PROCESS_NAME"
      docker compose down --volumes --remove-orphans
      ;;
    esac
  }
  trap cleanup EXIT

  wait_until_ready
  "$@"
}

case "${1:-}" in
start)
  start
  ;;
stop)
  stop
  ;;
run)
  shift
  if (($# == 0)); then
    echo "usage: $0 run COMMAND [ARG ...]" >&2
    exit 2
  fi
  run "$@"
  ;;
*)
  echo "usage: $0 {start|stop|run COMMAND [ARG ...]}" >&2
  exit 2
  ;;
esac
